# Copy this file to .env and fill in real values. Never commit .env.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=4000

# MongoDB. Tests use MONGODB_URI_TEST and refuse to run unless the DB name ends in "_test".
MONGODB_URI=mongodb://127.0.0.1:27017/lost_found_dev
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/lost_found_test

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars
SESSION_TTL_HOURS=24
BCRYPT_ROUNDS=12
# Max login/register attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Set to true when running behind a reverse proxy (Nginx, Render, Heroku...)
TRUST_PROXY=false

# Public URL of the web app (used in notification emails)
APP_URL=http://localhost:5173

# Image uploads (stored outside any public/static directory)
# UPLOAD_DIR=./server/storage/uploads
MAX_UPLOAD_MB=5

LOG_LEVEL=info

# Optional email notifications. Leave SMTP_HOST empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Lost & Found <no-reply@example.com>"
